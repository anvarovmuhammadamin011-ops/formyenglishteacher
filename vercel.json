{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build -w client",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/((?!offline).*)", "destination": "/api/offline" },
    { "source": "/uploads/(.*)", "destination": "/api/offline" },
    { "source": "/((?!api|uploads).*)", "destination": "/index.html" }
  ]
}
