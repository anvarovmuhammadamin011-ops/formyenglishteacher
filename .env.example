# ── Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# PostgreSQL connection string.
# Leave DATABASE_URL empty to automatically boot an embedded PostgreSQL
# (great for local development). In production point this at your own server.
DATABASE_URL=

# ── Auth ───────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-32-chars-min
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false
# lax (default) for same-site. Use "none" (COOKIE_SECURE=true is implied) when
# the frontend is deployed on another domain (e.g. Vercel) and calls this API.
COOKIE_SAMESITE=lax

# ── CORS ───────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CLIENT_ORIGIN=http://localhost:5173

# ── AI provider (OpenAI-compatible chat completions) ──
# Works with OpenAI, DeepSeek, Groq, Mistral, Ollama, OpenRouter, etc.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_TOKENS=8000
AI_TEMPERATURE=0.4
